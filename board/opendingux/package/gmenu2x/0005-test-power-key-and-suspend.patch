diff --git a/src/gmenu2x.cpp b/src/gmenu2x.cpp
index d06c4dd..78fb118 100644
--- a/src/gmenu2x.cpp
+++ b/src/gmenu2x.cpp
@@ -614,11 +614,16 @@ void GMenu2X::mainLoop() {
 			if (button == InputManager::QUIT) {
 				break;
 			}
+			bool handled = false;
 			for (auto it = layers.rbegin(); it != layers.rend(); ++it) {
 				if ((*it)->handleButtonPress(button)) {
+					handled = true;
 					break;
 				}
 			}
+			if (!handled && button == InputManager::POWER) {
+				PowerSaver::getInstance()->suspend();
+			}
 		}
 	}
 }
