@@ -26,6 +27,7 @@ private:
 	static std::shared_ptr<PowerSaver> instance;
 
 	bool screenState;
+	bool suspendAvailable;
 	unsigned int screenTimeout;
 	unsigned int timeout_startms;
 	SDL_TimerID screenTimer;
