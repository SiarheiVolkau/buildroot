diff --git a/src/powersaver.cpp b/src/powersaver.cpp
index 56d05f5..b99fc87 100644
--- a/src/powersaver.cpp
+++ b/src/powersaver.cpp
@@ -35,10 +35,25 @@ std::shared_ptr<PowerSaver> PowerSaver::getInstance()
 
 PowerSaver::PowerSaver()
 	: screenState(false)
+	, suspendAvailable(false)
 	, screenTimeout(0)
 	, screenTimer(nullptr)
 {
 	enableScreen();
+
+	const char * sysPowerState = "/sys/power/state";
+	int fd = ::open(sysPowerState, O_RDONLY);
+	if (fd != -1) {
+		char buf[64];
+		ssize_t read = ::read(fd, buf, sizeof(buf));
+		if (read == -1) {
+			WARNING("Error reading '%s': %s\n", sysPowerState, ::strerror(errno));
+		}
+		if (::strstr(buf, "mem")) {
+			suspendAvailable = true;
+		}
+		::close(fd);
+	}
 }
 
 PowerSaver::~PowerSaver() {
@@ -46,6 +61,27 @@ PowerSaver::~PowerSaver() {
 	enableScreen();
 }
 
+void PowerSaver::suspend()
+{
+	if (!suspendAvailable) {
+		return;
+	}
+
+	const char * sysPowerState = "/sys/power/state";
+	int fd = ::open(sysPowerState, O_RDWR);
+	if (fd == -1) {
+		WARNING("Error opening '%s': %s\n", sysPowerState, ::strerror(errno));
+	} else {
+		ssize_t written = ::write(fd, "mem", ::strlen("mem"));
+		if (written == -1) {
+			WARNING("Error writing to '%s': %s\n", sysPowerState, ::strerror(errno));
+		}
+		::close(fd);
+		screenState = false; /* to avoid handling power button at wakeup */
+	}
+}
+
+
 void PowerSaver::setScreenTimeout(unsigned int seconds) {
 	screenTimeout = seconds;
 	resetScreenTimer();
diff --git a/src/powersaver.h b/src/powersaver.h
