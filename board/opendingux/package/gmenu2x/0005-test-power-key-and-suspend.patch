@@ -108,8 +108,11 @@ bool InputManager::readConfFile(const string &conffile) {
 			else if (name == "altright") button = ALTRIGHT;
 			else if (name == "menu")     button = MENU;
 			else if (name == "settings") button = SETTINGS;
+			else if (name == "power")    button = POWER;
+			else if (name == "vol+")     button = VOL_UP;
+			else if (name == "vol-")     button = VOL_DN;
 			else {
-				WARNING("InputManager: Ignoring unknown button name \"%s\"\n",
+				WARNING("InputManager: Ignoring unused by gmenu2x button name \"%s\"\n",
 						name.c_str());
 				continue;
 			}
@@ -184,11 +187,14 @@ bool InputManager::getButton(Button *button, bool wait) {
 	else if (!SDL_PollEvent(&event))
 		return false;
 
-	bool is_kb = false, is_js = false;
+	bool is_kb = false, is_js = false, is_key_release = false;
 	switch(event.type) {
 		case SDL_KEYDOWN:
 			is_kb = true;
 			break;
+		case SDL_KEYUP:
+			is_key_release = true;
+			break;
 #ifndef SDL_JOYSTICK_DISABLED
 		case SDL_JOYHATMOTION: {
 				Joystick *joystick = &joysticks[event.jaxis.which];
@@ -271,8 +277,10 @@ bool InputManager::getButton(Button *button, bool wait) {
 		for (i = 0; i < BUTTON_TYPE_SIZE; i++) {
 			if (buttonMap[i].kb_mapped
 					&& (unsigned int)event.key.keysym.sym == buttonMap[i].kb_code) {
-				*button = static_cast<Button>(i);
-				break;
+				if (i != static_cast<int>(POWER)) {
+					*button = static_cast<Button>(i);
+					break;
+				}
 			}
 		}
 #ifndef SDL_JOYSTICK_DISABLED
@@ -285,6 +293,13 @@ bool InputManager::getButton(Button *button, bool wait) {
 			}
 		}
 #endif
+	} else if (is_key_release) {
+		if (buttonMap[POWER].kb_mapped && event.key.keysym.sym == buttonMap[POWER].kb_code) {
+			*button = POWER;
+			i = POWER;
+		} else {
+			i = BUTTON_TYPE_SIZE;
+		}
 	}
 
 	if (i == BUTTON_TYPE_SIZE)
@@ -293,7 +308,7 @@ bool InputManager::getButton(Button *button, bool wait) {
 	bool screenState = PowerSaver::getInstance()->getScreenState();
 	if (wait) {
 		PowerSaver::getInstance()->resetScreenTimer();
-		
+
 		// if screen was previously off (false), then don't process the input
 		return screenState;
 	}
diff --git a/src/inputmanager.h b/src/inputmanager.h
index 61dd55f..f031d13 100644
--- a/src/inputmanager.h
+++ b/src/inputmanager.h
@@ -47,15 +47,18 @@ struct Joystick {
 class InputManager {
 public:
 	enum Button {
-		UP, DOWN, LEFT, RIGHT,
+		UP = 0, DOWN, LEFT, RIGHT,
 		ACCEPT, CANCEL,
 		ALTLEFT, ALTRIGHT,
 		MENU, SETTINGS,
+		POWER,
