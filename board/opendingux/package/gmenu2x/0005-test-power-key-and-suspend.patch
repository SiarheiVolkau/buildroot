+
+		BUTTON_TYPE_SIZE,
 		// Events that are not actually buttons:
 		// (not included in BUTTON_TYPE_SIZE)
-		REPAINT, QUIT,
+		REPAINT = BUTTON_TYPE_SIZE, QUIT,
 	};
-	static constexpr size_t BUTTON_TYPE_SIZE = 10;
 
 	InputManager(GMenu2X& gmenu2x);
