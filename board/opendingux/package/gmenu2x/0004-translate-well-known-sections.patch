--- a/src/menu.cpp
+++ b/src/menu.cpp
@@ -174,7 +174,7 @@ void Menu::updateSectionTextSurfaces() {
 	const auto &font = *gmenu2x.font;
 	section_text_surfaces.resize(sections.size());
 	for (std::size_t i = 0; i < sections.size(); ++i)
