+#define CMD_END    (~0U)
+#define CMD_DELAY  (CMD_END - 1U)
+#define CMD_RESET  (CMD_END - 2U)
+static const u32 uc8230_init_sequence[] = {
+	/* register/cmd  | value */
+	CMD_RESET,	1,
+	CMD_DELAY,	10,
+	CMD_RESET,	0,
+	CMD_DELAY,	100, //at least 100ms
+	0x0046,		0x0002, //MTP Disable
+	0x0010,		0x1590, //SAP=1, BT=5, APE=1, AP=1
+	0x0011,		0x0227, //DC1=2, DC0=2, VC=7
+	0x0012,		0x80ff, //P5VMD=1, PON=7, VRH=15
+	0x0013,		0x9F31, //VDV=31, VCM=49
+	CMD_DELAY,	10, //at least 10ms
+	0x0003,		0x1038, //set GRAM writing direction & BGR=1
+	0x0060,		0xa700, //GS; gate scan: start position & drive line Q'ty - mirrors across vertical center line
+	0x0061,		0x0001, //REV, NDL, VLE - mandatory to have normal colors
+	0x0020,		0x0000, //GRAM horizontal address
+	0x0021,		0x0000, //GRAM vertical address
+	0x0050,		0x0000, // write window y-start 0
+	0x0051,		240 -1, // write window y-end 240-1 (whole y size)
+	0x0052,		0x0000, // write window x-start 0
+	0x0053,		320 -1, // write window x-end 320-1 (whole x size)
+	0x0080,		0x0000,
+	0x0081,		0x0000,
+	0x0082,		0x0000,
+	0x0083,		0x0000,
+	0x0084,		0x0000,
+	0x0085,		0x0000,
+	0x0092,		0x0200,
+	0x0093,		0x0303,
+	0x0090,		0x0010, //set clocks/Line
+	0x000C,		0x0000,
+	0x0000,		0x0001,
+	CMD_DELAY,	20, // Delay 200 ms
+	0x0007,		0x0173, //Display on setting
+	CMD_END,
+};
+
+static const u32 uc8230_suspend_sequence[] = {
+	/* register/cmd  | value */
+	CMD_RESET,	1,
+	CMD_DELAY,	10,
+	CMD_RESET,	0,
+	// init sequence needed at resume
+	CMD_END,
+};
+
+/* FIXME add support of of N-bit wide commands */
+/* now it supports 16-bit cmds thru 8-bit iface only */
+static void jzfb_write_panel_command(struct jzfb *jzfb, u16 cmd)
+{
+	while (readb(jzfb->base + JZ_REG_SLCD_STATE) & SLCD_STATE_BUSY);
+	writel(BIT(31) | (cmd >> 8), jzfb->base + JZ_REG_SLCD_DATA);
+	while (readb(jzfb->base + JZ_REG_SLCD_STATE) & SLCD_STATE_BUSY);
+	writel(BIT(31) | (cmd & 0xff), jzfb->base + JZ_REG_SLCD_DATA);
+}
+
+/* FIXME add support of of N-bit wide datas */
+/* now it supports 16-bit data thru 8-bit iface only */
+static void jzfb_write_panel_data(struct jzfb *jzfb, u16 data)
+{
+	while (readb(jzfb->base + JZ_REG_SLCD_STATE) & SLCD_STATE_BUSY);
+	writel(data, jzfb->base + JZ_REG_SLCD_DATA);
+}
+
+static void jzfb_exec_commands_sequence(struct jzfb *jzfb, const u32* cmds)
+{
+	gpiod_set_value_cansleep(jzfb->cs, 0);
+
+	while (cmds[0] != CMD_END) {
+		if (cmds[0] == CMD_DELAY) {
+			msleep(cmds[1]);
+		} else if (cmds[0] == CMD_RESET) {
+			if (jzfb->rst) {
+				gpiod_set_value_cansleep(jzfb->rst, cmds[1]);
+			}
+		} else {
+			jzfb_write_panel_command(jzfb, *cmds);
+			jzfb_write_panel_data(jzfb, cmds[1]);
+		}
+		cmds += 2;
+	}
+	while (readb(jzfb->base + JZ_REG_SLCD_STATE) & SLCD_STATE_BUSY);
+	gpiod_set_value_cansleep(jzfb->cs, 1);
+}
+
